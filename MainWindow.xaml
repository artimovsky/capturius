<Window x:Class="Capturius.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturius"
        Height="96" Width="308"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#9399B2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptureBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CoffeeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#585B70"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tb"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   HorizontalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tb" Property="Foreground" Value="#9399B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E2E" CornerRadius="8" BorderBrush="#313244" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Border DockPanel.Dock="Top" Height="22" Background="#181825"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel Margin="10,0,4,0">
                    <TextBlock Text="Capturius"
                               Foreground="#9399B2" FontSize="12" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarBtn}"
                                ToolTip="Settings"
                                Click="Settings_Click"
                                Margin="0,0,2,0">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#DFF9FF" Data="M22.5 10.5h-2.247a11.8 11.8 0 0 0-1-2.922l1.589-1.588a1 1 0 0 0 0-1.414l-1.418-1.414a1 1 0 0 0-1.414 0l-1.59 1.589a11.8 11.8 0 0 0-2.92-1V1.5a1 1 0 0 0-1-1h-1a1 1 0 0 0-1 1v2.249a11.8 11.8 0 0 0-2.921 1l-1.59-1.587a1 1 0 0 0-1.414 0L3.16 4.577a1 1 0 0 0 0 1.414L4.75 7.58a11.8 11.8 0 0 0-1 2.921H1.5a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1h2.246a11.8 11.8 0 0 0 1 2.921l-1.59 1.59a1 1 0 0 0 0 1.414l1.419 1.414a1 1 0 0 0 1.414 0l1.589-1.59a11.8 11.8 0 0 0 2.922 1v2.25a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2.245a11.8 11.8 0 0 0 2.92-1l1.591 1.589a1 1 0 0 0 1.414 0l1.414-1.414a1 1 0 0 0 0-1.414l-1.589-1.59a11.8 11.8 0 0 0 1-2.921h2.25a1 1 0 0 0 1-1v-1a1 1 0 0 0-1-1.005m-10.5 6a4.5 4.5 0 1 1 4.5-4.5 4.5 4.5 0 0 1-4.5 4.5"/>
                                    <Path Fill="#fff" Data="M3.746 13.5a11.8 11.8 0 0 0 1 2.921l-1.59 1.59a1 1 0 0 0 0 1.414l.707.707 4.95-4.95a4.5 4.5 0 0 1 6.365-6.365l4.949-4.949-.707-.707a1 1 0 0 0-1.414 0l-1.586 1.59a11.8 11.8 0 0 0-2.92-1V1.5a1 1 0 0 0-1-1h-1a1 1 0 0 0-1 1v2.249a11.8 11.8 0 0 0-2.921 1l-1.59-1.587a1 1 0 0 0-1.414 0L3.16 4.577a1 1 0 0 0 0 1.414L4.75 7.58a11.8 11.8 0 0 0-1 2.921H1.5a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1Z"/>
                                    <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M22.5 10.5h-2.247a11.8 11.8 0 0 0-1-2.922l1.589-1.588a1 1 0 0 0 0-1.414l-1.418-1.414a1 1 0 0 0-1.414 0l-1.59 1.589a11.8 11.8 0 0 0-2.92-1V1.5a1 1 0 0 0-1-1h-1a1 1 0 0 0-1 1v2.249a11.8 11.8 0 0 0-2.921 1l-1.59-1.587a1 1 0 0 0-1.414 0L3.16 4.577a1 1 0 0 0 0 1.414L4.75 7.58a11.8 11.8 0 0 0-1 2.921H1.5a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1h2.246a11.8 11.8 0 0 0 1 2.921l-1.59 1.59a1 1 0 0 0 0 1.414l1.419 1.414a1 1 0 0 0 1.414 0l1.589-1.59a11.8 11.8 0 0 0 2.922 1v2.25a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2.245a11.8 11.8 0 0 0 2.92-1l1.591 1.589a1 1 0 0 0 1.414 0l1.414-1.414a1 1 0 0 0 0-1.414l-1.589-1.59a11.8 11.8 0 0 0 1-2.921h2.25a1 1 0 0 0 1-1v-1a1 1 0 0 0-1-1.005m-10.5 6a4.5 4.5 0 1 1 4.5-4.5 4.5 4.5 0 0 1-4.5 4.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Content="✕"
                                ToolTip="Close to tray"
                                Click="CloseToTray_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Coffee button -->
            <Button DockPanel.Dock="Bottom"
                    Style="{StaticResource CoffeeBtn}"
                    Content="☕ Buy me a coffee"
                    Margin="0,0,0,6"
                    Click="BuyMeCoffee_Click"/>

            <!-- Capture buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="12,0">
                <Button Style="{StaticResource CaptureBtn}"
                        Click="CaptureFullScreen_Click"
                        Margin="0,0,8,0"
                        ToolTip="Capture the entire screen  [PrintScreen]">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#9FEAFF" Data="M.5 17V4.5A1.5 1.5 0 0 1 2 3h20a1.5 1.5 0 0 1 1.5 1.5V17Z"/>
                            <Path Fill="#DFF9FF" Data="M19 3H2A1.5 1.5 0 0 0 .5 4.5V17H5Z"/>
                            <Path Fill="White" Data="M.5 17h23v2.5A1.5 1.5 0 0 1 22 21H2a1.5 1.5 0 0 1-1.5-1.5z"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M.5 17h23M2 3h20s1.5 0 1.5 1.5v15s0 1.5-1.5 1.5H2S.5 21 .5 19.5v-15S.5 3 2 3"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource CaptureBtn}"
                        Click="CaptureDesktop_Click"
                        Margin="0,0,8,0"
                        ToolTip="Full screen without taskbar  [Shift+PrintScreen]">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#9FEAFF" Data="M.5 20.757V4.903A1.5 1.903 0 0 1 2 3h20a1.5 1.903 0 0 1 1.5 1.903v15.854Z"/>
                            <Path Fill="#DFF9FF" Data="M19 3H2A1.5 1.88 0 0 0 .5 4.88v15.668H5Z"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2 3h20s1.5 0 1.5 1.5v15s0 1.5-1.5 1.5H2S.5 21 .5 19.5v-15S.5 3 2 3"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource CaptureBtn}"
                        Click="CaptureActiveWindow_Click"
                        Margin="0,0,8,0"
                        ToolTip="Capture the active window  [Alt+PrintScreen]">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#9FEAFF" Data="M23.5 7v13a2 2 0 0 1-2 2h-19a2 2 0 0 1-2-2V7Z"/>
                            <Path Fill="#DFF9FF" Data="M2.5 22h2l15-15H.5v13a2 2 0 0 0 2 2"/>
                            <Path Fill="White" Data="M23.5 7H.5V4a2 2 0 0 1 2-2h19a2 2 0 0 1 2 2Z"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M2.5 2.004h19s2 0 2 2v16s0 2-2 2h-19s-2 0-2-2v-16s0-2 2-2M.5 7.004h23"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M4 4.254a.25.25 0 1 1-.25.25.25.25 0 0 1 .25-.25M7 4.254a.25.25 0 1 1-.25.25.25.25 0 0 1 .25-.25M10 4.254a.25.25 0 1 1-.25.25.25.25 0 0 1 .25-.25"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource CaptureBtn}"
                        Click="CaptureRegion_Click"
                        Margin="0,0,8,0"
                        ToolTip="Select a custom region  [Ctrl+PrintScreen]">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#DFF9FF" Data="M3 6.5h18s.5 0 .5.5v10s0 .5-.5.5H3s-.5 0-.5-.5V7s0-.5.5-.5"/>
                            <Path Fill="Transparent" Stroke="#DFF9FF" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M16.5 4.5h6a1 1 0 0 1 1 1v4M7.5 4.5h-6a1 1 0 0 0-1 1v4M16.5 19.5h6a1 1 0 0 0 1-1v-4M7.5 19.5h-6a1 1 0 0 1-1-1v-4"/>
                            <Path Fill="#9FEAFF" Data="M5.5 8.499h13s1 0 1 1v5s0 1-1 1h-13s-1 0-1-1v-5s0-1 1-1"/>
                            <Path Fill="#DFF9FF" Data="M19.5 10.5v-1a1 1 0 0 0-1-1h-13a1 1 0 0 0-1 1v1Z"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5.5 8.499h13s1 0 1 1v5s0 1-1 1h-13s-1 0-1-1v-5s0-1 1-1"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource CaptureBtn}"
                        Click="CaptureScroll_Click"
                        Margin="0,0,8,0"
                        ToolTip="Scrolling screenshot">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#9FEAFF" Data="m 2,3.6552345 h 20 a 1,1 0 0 1 1,1 V 18.65523 a 1,1 0 0 1 -1,1 H 2 a 1,1 0 0 1 -1,-1 V 4.6552345 a 1,1 0 0 1 1,-1 z"/>
                            <Path Fill="#DFF9FF" Data="m 1,4.6552345 a 1,1 0 0 1 1,-1 h 20 a 1,1 0 0 1 1,1 v 2.5 H 1 Z"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="m 4,10.65523 h 10 m -10,3 h 8 m -8,3 h 6"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="m 1,4.6552345 a 1,1 0 0 1 1,-1 h 20 a 1,1 0 0 1 1,1 V 18.65523 a 1,1 0 0 1 -1,1 H 2 a 1,1 0 0 1 -1,-1 z m 0,2.5 h 22"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 19,9.6552345 V 16.65523 m -2.5,-2.5 2.5,2.5 2.5,-2.5"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource CaptureBtn}"
                        Click="ColorPicker_Click"
                        ToolTip="Pick a color from screen  [Ctrl+Shift+C]">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Fill="#DFF9FF" Data="M22.182 8.185 19 11.365l-6.36-6.36 3.18-3.19a4.5 4.5 0 1 1 6.36 6.37ZM19 11.365 10.173 20.2a4.5 4.5 0 0 1-5.111.87l-2 2a1.51 1.51 0 0 1-2.12 0 1.493 1.493 0 0 1 0-2.12l2-2a4.48 4.48 0 0 1 .87-5.11l8.83-8.83Z"/>
                            <Path Fill="#9FEAFF" Data="M22.18 8.18 19 11.36l-3.24-3.24 6.35-6.36a4.4 4.4 0 0 1 1.24 2.07 4.52 4.52 0 0 1-1.17 4.35"/>
                            <Path Fill="#9FEAFF" Data="m19 11.36-8.83 8.83a4.5 4.5 0 0 1-5.11.87l-2 2a1.51 1.51 0 0 1-2.12 0 .4.4 0 0 1-.06-.07L15.76 8.12Z"/>
                            <Path Fill="Transparent" Stroke="#00303E" StrokeThickness="1"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M22.182 8.185 19 11.365l-6.36-6.36 3.18-3.19a4.5 4.5 0 1 1 6.36 6.37ZM20.412 12.775l-1.41-1.41M12.642 5.005l-1.42-1.42M19 11.365 10.173 20.2a4.5 4.5 0 0 1-5.111.87l-2 2a1.51 1.51 0 0 1-2.12 0 1.493 1.493 0 0 1 0-2.12l2-2a4.48 4.48 0 0 1 .87-5.11l8.83-8.83ZM9.57 8.069 11.5 10M7.57 10.069 9.5 12M5.57 12.069 7.5 14"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
