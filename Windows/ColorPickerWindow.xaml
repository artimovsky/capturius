<Window x:Class="Capturius.Windows.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        Topmost="True"
        Cursor="None"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="0" Top="0">
    <Grid>
        <!-- Скриншот как фон -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- Перехват кликов мыши -->
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"/>

        <!-- Лупа -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="MagnifierPanel"
                    Width="200"
                    BorderBrush="#89B4FA"
                    BorderThickness="2"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="#181825">
                <StackPanel>
                    <!-- Увеличенные пиксели -->
                    <Canvas Background="Black" ClipToBounds="True" Width="200" Height="200">
                        <Image x:Name="MagnifierImage" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <!-- Квадрат вокруг центрального пикселя (1px физический = 10px в лупе) -->
                        <Rectangle Canvas.Left="95" Canvas.Top="95" Width="10" Height="10"
                                   Stroke="#FF4444" StrokeThickness="1" Fill="Transparent" Opacity="0.8"/>
                    </Canvas>

                    <!-- Цвет -->
                    <Border Padding="10,8" Background="#12121C">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border x:Name="ColorSwatch"
                                        Width="22" Height="22"
                                        CornerRadius="3"
                                        BorderBrush="#45475A"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"/>
                                <TextBlock x:Name="HexText"
                                           Foreground="White"
                                           FontSize="15"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MagnifierCoords"
                                       Foreground="#585B70"
                                       FontSize="10"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Подсказка снизу -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Border Background="#CC1E1E2E" CornerRadius="6" Padding="12,6">
                <TextBlock Text="Click / Enter — copy HEX  •  Arrows — fine-tune  •  ESC — cancel"
                           Foreground="#CDD6F4" FontSize="13" FontFamily="Segoe UI"
                           HorizontalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
