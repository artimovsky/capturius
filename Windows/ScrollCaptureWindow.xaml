<Window x:Class="Capturius.Windows.ScrollCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#EE1E1E2E"
            CornerRadius="8"
            BorderBrush="#313244"
            BorderThickness="1"
            Padding="16,12">
        <StackPanel>
            <!-- Recording indicator -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                <Ellipse Width="8" Height="8" Fill="#F38BA8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="Scrolling screenshot"
                           Foreground="#CDD6F4" FontSize="13" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Captured height counter -->
            <TextBlock x:Name="HeightText"
                       Text="—"
                       Foreground="#89B4FA" FontSize="12" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>

            <!-- Hint -->
            <TextBlock x:Name="HintText"
                       Text="Starting…"
                       Foreground="#6C7086" FontSize="11" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <!-- Stop button -->
            <Button Content="Stop" Click="Stop_Click" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#313244" CornerRadius="6" Padding="20,6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="#CDD6F4" FontSize="12" FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
