<Window x:Class="Capturius.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="Black"
        Topmost="True"
        Cursor="None"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Left="0" Top="0">
    <Grid>
        <!-- Скриншот экрана как фон -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- Тёмный оверлей и выделение -->
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown">
            <Path x:Name="DarkOverlay" Fill="#88000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="SelectionBorder"
                       Stroke="#89B4FA"
                       StrokeThickness="2"
                       StrokeDashArray="6 3"
                       Fill="Transparent"
                       Visibility="Collapsed"
                       IsHitTestVisible="False"/>
        </Canvas>

        <!-- Лупа (не перехватывает события мыши) -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="MagnifierPanel"
                    Width="200" Height="200"
                    BorderBrush="#89B4FA"
                    BorderThickness="2"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <Canvas Background="Black" ClipToBounds="True" Width="200" Height="200">
                    <!-- Изображение позиционируется в коде так, чтобы курсор всегда был в точке 100,100 -->
                    <Image x:Name="MagnifierImage" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <!-- Перекрестие всегда в центре лупы -->
                    <Line X1="100" Y1="0" X2="100" Y2="200"
                          Stroke="#FF4444" StrokeThickness="1" Opacity="0.8"/>
                    <Line X1="0" Y1="100" X2="200" Y2="100"
                          Stroke="#FF4444" StrokeThickness="1" Opacity="0.8"/>
                    <!-- Координаты внизу -->
                    <TextBlock x:Name="MagnifierCoords"
                               Width="200" TextAlignment="Center"
                               Foreground="White" FontSize="11" FontFamily="Segoe UI"
                               Background="#88000000" Padding="4,2"
                               Canvas.Top="178"/>
                </Canvas>
            </Border>
        </Canvas>

        <!-- Подсказка снизу -->
        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24">
            <Border Background="#CC1E1E2E" CornerRadius="6" Padding="12,6">
                <StackPanel>
                    <TextBlock x:Name="HintText"
                               Text="Click to set first point  •  ESC — cancel"
                               Foreground="#CDD6F4" FontSize="13" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SizeText"
                               Foreground="#89B4FA" FontSize="12" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
