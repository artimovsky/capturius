<Window x:Class="Capturius.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screenshot Editor"
        Width="1200" Height="800"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
    <Window.Resources>
        <!-- Tool toggle button -->
        <Style x:Key="ToolBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action button -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#45475A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#585B70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action button (Save) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#1E66F5"/>
            <Setter Property="BorderBrush" Value="#1E66F5"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E77F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Separator -->
        <Style x:Key="Sep" TargetType="Separator">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,4"/>
        </Style>

    </Window.Resources>

    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#181825" BorderThickness="0,0,0,1" BorderBrush="#313244">
            <StackPanel Orientation="Vertical">

                <!-- Row 1: Tools (left) | Zoom (center) | Copy+Save (right) -->
                <Grid Margin="8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tools + Undo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="BtnArrow" Style="{StaticResource ToolBtn}"
                                      Checked="Tool_Checked" Tag="Arrow" IsChecked="True" ToolTip="Arrow">
                            <Viewbox Width="16" Height="16">
                                <Path Fill="Transparent" Stroke="#CDD6F4" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M35.127 32.441c1.196 1.609 3.44 1.272 4.145-.606 1.732-4.61 3.077-10.102 4.002-14.526a3.863 3.863 0 0 0-2.578-4.465c-4.315-1.42-9.777-3.01-14.654-3.81-1.957-.321-3.353 1.414-2.569 3.236.614 1.427 1.496 3.304 2.756 5.692-2.602 1.282-6.049 3.09-10.323 5.557-4.28 2.471-7.57 4.553-9.982 6.166l5.37 9.282a174 174 0 0 0 10.339-5.528 174 174 0 0 0 9.963-6.194c1.42 2.25 2.6 3.944 3.53 5.196"/>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnRect"  Style="{StaticResource ToolBtn}"
                                      Checked="Tool_Checked" Tag="Rect" Margin="2,0,0,0" ToolTip="Rectangle">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="48" Height="48">
                                    <Path Stroke="#CDD6F4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M3.50259 11.6223c0.21916 -2.20332 1.85062 -3.8419 4.05499 -4.05055C10.4991 7.29334 15.5931 7 24 7c8.4069 0 13.5009 0.29334 16.4424 0.57175 2.2044 0.20865 3.8358 1.84723 4.055 4.05055 0.2509 2.5221 0.5026 6.5137 0.5026 12.3776 0 5.864 -0.2517 9.8557 -0.5026 12.3777 -0.2192 2.2034 -1.8506 3.842 -4.055 4.0507C37.5009 40.7067 32.4069 41 24 41c-8.4069 0 -13.5009 -0.2933 -16.44238 -0.5717 -2.2044 -0.2087 -3.83586 -1.8473 -4.05503 -4.0507C3.25173 33.8556 3 29.8639 3 23.9999c0 -5.8639 0.25173 -9.8555 0.50259 -12.3776Z"/>
                                </Canvas>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnText"  Style="{StaticResource ToolBtn}"
                                      Checked="Tool_Checked" Tag="Text" Margin="2,0,0,0" ToolTip="Text">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M5,4V7H11V19H13V7H19V4H5Z" Fill="#CDD6F4"/>
                            </Viewbox>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnCrop"  Style="{StaticResource ToolBtn}"
                                      Checked="Tool_Checked" Tag="Crop" Margin="2,0,0,0" ToolTip="Crop">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M7,17H5V5A2,2 0 0,1 7,3H19V5H7V17M17,7H19V19A2,2 0 0,1 17,21H5V19H17V7Z" Fill="#CDD6F4"/>
                            </Viewbox>
                        </ToggleButton>

                        <!-- Crop apply (visible only in crop mode) -->
                        <Button x:Name="BtnApplyCrop" Style="{StaticResource ActionBtn}"
                                Click="ApplyCrop_Click" Margin="4,0,0,0" Visibility="Collapsed" ToolTip="Apply crop">
                            <Viewbox Width="16" Height="16">
                                <Path Data="M9,20.42L2.79,14.2L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z" Fill="#CDD6F4"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Center: Zoom -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionBtn}" Content="&#x2212;" Width="30" Padding="0,6" Click="ZoomOut_Click" ToolTip="Zoom out"/>
                        <TextBlock x:Name="ZoomLabel" Foreground="#CDD6F4" FontSize="12" FontFamily="Segoe UI"
                                   VerticalAlignment="Center" Margin="6,0" Width="38" TextAlignment="Center"/>
                        <Button Style="{StaticResource ActionBtn}" Content="+" Width="30" Padding="0,6" Click="ZoomIn_Click" ToolTip="Zoom in"/>
                        <Button Style="{StaticResource ActionBtn}" Content="1:1" Click="ZoomReset_Click"
                                ToolTip="Reset zoom" Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Right: Undo + Copy + Save -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionBtn}" Click="Undo_Click"
                                ToolTip="Undo last action" Margin="0,0,4,0">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="48" Height="48">
                                    <Path Stroke="#CDD6F4" StrokeThickness="3" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="m 20.749609,34.24017 c 1.787911,0.267434 2.987579,-1.202238 2.341655,-2.890732 a 91.73,91.73 0 0 0 -1.827584,-4.37781 c 1.21242,-0.686692 2.315976,-1.239367 3.264429,-1.673618 2.061562,-0.946051 4.412161,-0.305747 5.955838,1.355061 l 6.145858,6.606039 c 0.745944,0.802877 1.803631,1.258454 2.847744,0.927011 0.423749,-0.13372 0.916476,-0.322557 1.470504,-0.587225 0.532372,-0.254323 0.974414,-0.509823 1.336039,-0.745747 0.913814,-0.597238 1.099657,-1.75326 0.647894,-2.747652 C 41.216547,26.331303 39.070197,22.566803 37.083156,19.37009 33.904619,14.254558 27.274609,12.905708 21.80244,15.421214 a 99.557,99.557 0 0 1 -5.04491,2.161784 86.76,86.76 0 0 0 -1.967521,-3.610548 c -0.907167,-1.562586 -2.804282,-1.552877 -3.72064,0.0064 -0.820426,1.398218 -1.9059876,3.387452 -3.2367946,6.129977 -1.6480198,3.393882 -2.4139832,5.718068 -2.7666283,7.195372 -0.3222313,1.353058 0.2890046,2.632556 1.5436076,3.231228 1.3721307,0.654461 3.6605393,1.519525 7.3358103,2.369281 2.97101,0.688589 5.200121,1.09546 6.804245,1.335434 z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource ActionBtn}" Click="Copy_Click"
                                ToolTip="Copy to clipboard" Margin="0,0,4,0">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="48" Height="48">
                                    <Path Stroke="#CDD6F4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M33.533 40.47c-.214 2.206-1.854 3.86-4.058 4.09-2.182.226-5.44.44-9.975.44s-7.793-.214-9.975-.44c-2.204-.23-3.844-1.884-4.058-4.09C5.231 38.034 5 34.196 5 28.5c0-5.695.231-9.534.467-11.97.214-2.206 1.854-3.86 4.058-4.09"/>
                                    <Path Stroke="#CDD6F4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M31.791 3.04c.612.179 3.018 1.06 6.563 4.592 3.317 3.304 4.305 5.615 4.566 6.398.05 1.595.08 3.411.08 5.47 0 5.695-.231 9.534-.467 11.97-.214 2.206-1.854 3.86-4.058 4.09-2.182.226-5.44.44-9.975.44s-7.793-.214-9.975-.44c-2.204-.23-3.844-1.884-4.058-4.09C14.231 29.034 14 25.195 14 19.5s.231-9.534.467-11.97c.214-2.206 1.854-3.86 4.058-4.09C20.707 3.214 23.965 3 28.5 3q1.773.001 3.291.04"/>
                                    <Path Stroke="#CDD6F4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M42.901 14.338c-1.67.254-4.58.09-6.953-.119a4.626 4.626 0 0 1-4.214-4.21c-.211-2.378-.374-5.294-.112-6.95"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource PrimaryBtn}" Click="Save_Click" ToolTip="Save file">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="48" Height="48">
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M36.756 4.347a5.56 5.56 0 0 0-3.234-1.172A242 242 0 0 0 24 3c-7.364 0-12.515.277-15.743.539-2.555.208-4.51 2.163-4.718 4.718C3.277 11.485 3 16.636 3 24s.277 12.515.539 15.743c.208 2.555 2.163 4.51 4.718 4.718C11.485 44.723 16.636 45 24 45s12.515-.277 15.743-.539c2.555-.208 4.51-2.163 4.718-4.718C44.723 36.515 45 31.364 45 24c0-3.729-.071-6.89-.175-9.522a5.56 5.56 0 0 0-1.173-3.234c-.86-1.09-1.988-2.428-3.229-3.668-1.24-1.24-2.578-2.368-3.667-3.229"/>
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M31.293 3.1c.034.705.056 1.544.056 2.526a52 52 0 0 1-.064 2.687c-.088 1.694-1.412 2.938-3.107 3.01-1.063.044-2.446.078-4.179.078s-3.115-.034-4.178-.079c-1.695-.07-3.019-1.315-3.107-3.009a52 52 0 0 1-.065-2.687c0-.982.023-1.821.057-2.526"/>
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"
                                          Data="M36.362 44.69c.126-2.013.237-4.851.237-8.615 0-4.47-.156-7.635-.31-9.662-.128-1.704-1.425-3.013-3.128-3.15-1.95-.156-4.953-.313-9.162-.313s-7.212.157-9.161.314c-1.704.136-3 1.445-3.129 3.15-.153 2.026-.31 5.191-.31 9.661 0 3.764.111 6.602.238 8.615"/>
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M19 31h10"/>
                                    <Path Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M19 37h6"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Tool properties (populated by the active tool) -->
                <Border Background="#11111B" BorderThickness="0,1,0,0" BorderBrush="#313244" Padding="8,4">
                    <ContentControl x:Name="ToolPropertiesHost" VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
        </Border>

        <!-- Image area -->
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="Scroller_PreviewMouseWheel">
            <ScrollViewer.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#606060">
                                <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#4A4A4A">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,8,8"/>
                                        <RectangleGeometry Rect="8,8,8,8"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </ScrollViewer.Background>
            <Grid x:Name="ZoomedContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform"/>
                </Grid.LayoutTransform>
                <Image x:Name="MainImage" Stretch="None"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Canvas x:Name="AnnotationCanvas"
                        Background="Transparent"
                        MouseLeftButtonDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseUp"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
